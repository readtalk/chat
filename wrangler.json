{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chat",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server/index.ts",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"build": {
		"command": "esbuild src/client/index.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist"
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Chat",
				"name": "Chat"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": ["Chat"],
			"tag": "v1"
		}
	],
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "SERVER_D1",
			"database_id": "9c6d47de-7136-494a-96aa-3e16648a4880"
		}
	],
	"kv_namespaces": [
		{
			"binding": "AUTH_STORAGE",
			"id": "54f89be27a414fabaf381a919403582e"
		}
	]
}
